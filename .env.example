# deploy/setup-droplet.sh creates .env from this and fills in the two generated secrets.
# Fill in the Supabase values below yourself. Never paste them into a chat.

# The domain pointing at your Droplet. HTTPS certificates are issued for it automatically.
DOMAIN=apply.example.com

# The password for the dashboard. The username can be anything.
APP_PASSWORD=

# Encrypts saved browser sign-ins. Losing it means signing in again, nothing worse.
SESSION_KEY=

# Encrypts saved employer account passwords. Back this up: losing it means those passwords are gone.
VAULT_KEY=

# Supabase dashboard > Connect > Session pooler. Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# Supabase dashboard > Project Settings > API: the project URL, and the secret (service_role) key.
# The key bypasses all access rules, so it belongs only in this file on the server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The private bucket for resumes and screenshots. It is created automatically.
STORAGE_BUCKET=applypilot

# Optional. Without it the app still runs, and every unknown question goes to you.
ANTHROPIC_API_KEY=

# How many application browsers may be open at once. Allow about 1 GB of RAM for each.
MAX_LIVE_BROWSERS=2

# How long a paused application keeps its browser open, in seconds.
PAUSE_TIMEOUT_SECONDS=1800
